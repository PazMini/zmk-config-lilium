#include "lilium.dtsi"


&kscan0 {
    col-gpios
        = <&pro_micro 3 GPIO_ACTIVE_HIGH>
        , <&pro_micro 4 GPIO_ACTIVE_HIGH>
        , <&pro_micro 5 GPIO_ACTIVE_HIGH>
        , <&pro_micro 6 GPIO_ACTIVE_HIGH>
        , <&pro_micro 7 GPIO_ACTIVE_HIGH>
        , <&pro_micro 2 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    physical_layouts {
        compatible = "zmk,physical-layouts";

        physical_layout0: physical_layout_0 {
            compatible = "zmk,physical-layout";
            display-name = "Lilium";

            kscan = <&kscan0>;
            transform = <&default_transform>;

            keys = <
                /* ALL 60 keys — exactly */
                &kscan0 0 0   0 0   1 1 0
                &kscan0 0 1   1 0   1 1 0
                &kscan0 0 2   2 0   1 1 0
                &kscan0 0 3   3 0   1 1 0
                &kscan0 0 4   4 0   1 1 0
                &kscan0 0 5   5 0   1 1 0
                &kscan0 0 6   6 0   1 1 0
                &kscan0 0 7   7 0   1 1 0
                &kscan0 0 8   8 0   1 1 0
                &kscan0 0 9   9 0   1 1 0
                &kscan0 0 10 10 0   1 1 0
                &kscan0 0 11 11 0   1 1 0

                &kscan0 1 0   0 1   1 1 0
                &kscan0 1 1   1 1   1 1 0
                &kscan0 1 2   2 1   1 1 0
                &kscan0 1 3   3 1   1 1 0
                &kscan0 1 4   4 1   1 1 0
                &kscan0 1 5   5 1   1 1 0
                &kscan0 1 6   6 1   1 1 0
                &kscan0 1 7   7 1   1 1 0
                &kscan0 1 8   8 1   1 1 0
                &kscan0 1 9   9 1   1 1 0
                &kscan0 1 10 10 1   1 1 0
                &kscan0 1 11 11 1   1 1 0

                &kscan0 2 0   0 2   1 1 0
                &kscan0 2 1   1 2   1 1 0
                &kscan0 2 2   2 2   1 1 0
                &kscan0 2 3   3 2   1 1 0
                &kscan0 2 4   4 2   1 1 0
                &kscan0 2 5   5 2   1 1 0
                &kscan0 2 6   6 2   1 1 0
                &kscan0 2 7   7 2   1 1 0
                &kscan0 2 8   8 2   1 1 0
                &kscan0 2 9   9 2   1 1 0
                &kscan0 2 10 10 2   1 1 0
                &kscan0 2 11 11 2   1 1 0

                &kscan0 3 0   0 3   1 1 0
                &kscan0 3 1   1 3   1 1 0
                &kscan0 3 2   2 3   1 1 0
                &kscan0 3 3   3 3   1 1 0
                &kscan0 3 4   4 3   1 1 0
                &kscan0 3 5   5 3   1 1 0
                &kscan0 3 6   6 3   1 1 0
                &kscan0 3 7   7 3   1 1 0
                &kscan0 3 8   8 3   1 1 0
                &kscan0 3 9   9 3   1 1 0
                &kscan0 3 10 10 3   1 1 0
                &kscan0 3 11 11 3   1 1 0

                &kscan0 4 0   0 4   1 1 0
                &kscan0 4 1   1 4   1 1 0
                &kscan0 4 2   2 4   1 1 0
                &kscan0 4 3   3 4   1 1 0
                &kscan0 4 4   4 4   1 1 0
                &kscan0 4 5   5 4   1 1 0
                &kscan0 4 6   6 4   1 1 0
                &kscan0 4 7   7 4   1 1 0
                &kscan0 4 8   8 4   1 1 0
                &kscan0 4 9   9 4   1 1 0
                &kscan0 4 10 10 4   1 1 0
                &kscan0 4 11 11 4   1 1 0
            >;
        };
    };
};